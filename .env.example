# PIN for authentication (set on first run if not provided; prompted interactively)
# MIZAN_PIN=

# Database file path (default: ./data/mizan.db)
# MIZAN_DB_PATH=./data/mizan.db

# Server port (default: 8080)
PORT=8080

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# CORS allowed origins (comma-separated, empty = disabled)
# MIZAN_CORS_ORIGINS=http://192.168.1.100:8081

# Timezone (default: Asia/Kolkata)
# MIZAN_TIMEZONE=Asia/Kolkata
