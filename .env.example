# Reference copy of the file install.sh generates at /opt/nasr/.env.
# You do not need to create it by hand — the installer writes it on first run
# and never overwrites it afterwards. nasr.service loads it via EnvironmentFile=,
# so systemd rules apply: no quotes, no export, no inline comments.

NODE_ENV=production

# Server port and bind address
PORT=8080
HOST=0.0.0.0

# Database file. install.sh sets this to an absolute path under the install dir.
NASR_DB_PATH=/opt/nasr/data/nasr.db

# The PIN is not stored here. install.sh hashes it into the settings table on
# first install; NASR_PIN only exists to skip the interactive prompt:
#   NASR_PIN=1234 ./install.sh

# NOT IMPLEMENTED YET — no server code reads these.
# NASR_CORS_ORIGINS=http://<dev-machine-ip>:8081   (planned, for the Expo client)
# NASR_TIMEZONE=Asia/Kolkata                       (timezone lives in the settings table)
