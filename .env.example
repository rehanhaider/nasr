# PIN for authentication (set on first run if not provided; prompted interactively)
# NASR_PIN=

# Database file path (default: ./data/nasr.db)
# NASR_DB_PATH=./data/nasr.db

# Server port (default: 8080)
PORT=8080

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# CORS allowed origins (comma-separated, empty = disabled)
# NOT IMPLEMENTED YET — nothing in the server reads this. Placeholder for the
# planned Expo client; set it to your dev machine's IP when that lands.
# NASR_CORS_ORIGINS=http://<dev-machine-ip>:8081

# Timezone (default: Asia/Kolkata)
# NASR_TIMEZONE=Asia/Kolkata
