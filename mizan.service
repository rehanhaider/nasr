[Unit]
Description=Mizan Progress Tracker
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/mizan
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production
Environment=MIZAN_DB_PATH=/opt/mizan/data/mizan.db
ExecStart=/usr/bin/node /opt/mizan/apps/web/.output/server/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
