[Unit]
Description=Nasr SQLite Backup

[Service]
Type=oneshot
WorkingDirectory=/opt/nasr
ExecStart=/bin/bash -c '\
  BACKUP_DIR=/opt/nasr/backups; \
  mkdir -p "$BACKUP_DIR"; \
  DB=/opt/nasr/data/nasr.db; \
  if [ -f "$DB" ]; then \
    cp "$DB" "$BACKUP_DIR/nasr-$(date +%%Y%%m%%d-%%H%%M%%S).db"; \
    find "$BACKUP_DIR" -name "nasr-*.db" -mtime +14 -delete; \
    echo "Backup complete. Retained 14 days."; \
  else \
    echo "No database found at $DB"; \
  fi'
