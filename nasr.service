[Unit]
Description=Nasr Progress Tracker
After=network.target

[Service]
Type=simple
User=rehan
WorkingDirectory=/opt/nasr
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=NODE_ENV=production
Environment=NASR_DB_PATH=/opt/nasr/data/nasr.db
ExecStart=/usr/bin/node /opt/nasr/apps/web/.output/server/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
