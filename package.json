{
  "name": "nasr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nasr/web dev",
    "build": "pnpm --filter @nasr/web build",
    "start": "pnpm --filter @nasr/web start",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @nasr/web db:migrate",
    "db:generate": "pnpm --filter @nasr/web db:generate"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@parcel/watcher",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
